{
  "name": "interviewiq-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "python -m uvicorn backend.main:app --reload --host 127.0.0.1 --port 8001",
    "dev:web": "vite --host 127.0.0.1 --port 5187 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 5187 --strictPort",
    "build": "tsc -b && vite build",
    "test": "python -m pytest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@supabase/supabase-js": "^2.57.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
